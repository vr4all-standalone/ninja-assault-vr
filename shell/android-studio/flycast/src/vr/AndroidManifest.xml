<?xml version="1.0" encoding="utf-8"?>
<!--
    hotd2-vr: merged on top of the main manifest for the "vr" build type. Makes the app an
    immersive OpenXR app on Meta Quest instead of a 2D window.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <!-- an immersive app with a 2D setup panel (a "hybrid" app) -->
    <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="69" horizonos:targetSdkVersion="69" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- the controllers' own models in the hands (XR_FB_render_model, rend/vr/xr_controllers.h) -->
    <uses-permission android:name="com.oculus.permission.RENDER_MODEL" />
    <uses-feature android:name="com.oculus.feature.RENDER_MODEL" android:required="false" />
    <!-- the player's game in the Download folder (or anywhere on the shared storage) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <!-- no TV banner or logo: the main manifest's are Flycast's art (res/drawable-xhdpi/ic_banner.xml
         takes its place in the resources too) -->
    <application
        android:label="Ninja Assault VR"
        tools:replace="android:label"
        tools:remove="android:banner,android:logo">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <!-- the game in VR: started by the start screen (NinjaStartActivity) with the game, or by adb;
             not in the library itself. Also openable with a game file, as the regular app. -->
        <activity-alias
            android:name="com.flycast.emulator.MainActivity"
            android:targetActivity="com.flycast.emulator.NativeGLActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- the start screen, the app's entry in the library: a 2D panel that checks the game's
             files and starts it in VR. In a process of its own, so it can end a game still
             running in the app's own process and start it afresh. -->
        <activity
            android:name="com.flycast.emulator.NinjaStartActivity"
            android:process=":setup"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <layout android:defaultHeight="640dp" android:defaultWidth="860dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
        </activity>
    </application>
</manifest>
